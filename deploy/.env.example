# ========== App ==========
APP_ENV=development
APP_VERSION=8.2.0
LOG_LEVEL=INFO

# ========== API ==========
API_HOST=0.0.0.0
API_PORT=8000

# ========== UI ==========
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
API_BASE_URL=http://financial-api:8000

PAGE_TITLE=Financial Research Copilot
