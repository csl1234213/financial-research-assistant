{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financial-rag-assistant.local/schemas/supervised-dataset-1.0.json",
  "title": "Financial Agent supervised fine-tuning dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "description": {"type": "string", "maxLength": 16000},
    "license": {"type": "string", "maxLength": 16000},
    "metadata": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "messages"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "messages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/message"}
        },
        "metadata": {"type": "object"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 16000}
      }
    }
  }
}
