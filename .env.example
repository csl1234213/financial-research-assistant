# ============================================================
# Financial Research Copilot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env              # development
#   cp .env.example .env.production   # production
#   cp .env.example .env.test         # testing
# ============================================================

# =========================
# App
# =========================

APP_ENV=development
APP_VERSION=8.2.0
LOG_LEVEL=INFO

# Multilingual E5 stays at 384 dimensions and is pinned to an immutable
# upstream commit for reproducible retrieval behavior.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=32

# Structured PDF ingestion. Disable OCR only when the host does not provide
# Tesseract and the configured language packs.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
OCR_ENABLED=true
OCR_LANGUAGES=eng+chi_sim
OCR_DPI=300
OCR_MIN_TEXT_CHARS=80
# JWT signing key.  Set this through a local .env file or your deployment
# secret manager; production refuses missing or placeholder values.
AUTH_SECRET_KEY=
# SECRET_KEY is accepted only as a backwards-compatible alias for AUTH_SECRET_KEY.

# =========================
# API
# =========================

API_HOST=0.0.0.0
API_PORT=8000

# =========================
# Database
# =========================

# Local Python development (outside Docker Compose)
DATABASE_URL=sqlite:///./financial_rag.db

# Docker Compose constructs its internal DATABASE_URL from these values.
# Use non-placeholder, URL-safe values in production and keep the real .env
# outside version control.
POSTGRES_USER=financial
# Required. Set a strong value in .env; never commit the real value.
POSTGRES_PASSWORD=
POSTGRES_DB=financial_rag

# =========================
# Redis
# =========================

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# Docker Compose protects Redis with this password and constructs an internal
# REDIS_URL for the API and worker.
# Required. Set a strong value in .env; never commit the real value.
REDIS_PASSWORD=

# =========================
# ChromaDB (Vector Store)
# =========================

CHROMA_PATH=chroma_db
# Leave blank to use the local persistent client. Docker Compose overrides
# this with the internal `chromadb` service name.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false

# =========================
# Storage
# =========================

UPLOAD_DIR=storage/uploads
PDF_DIR=storage/pdfs

# Automatic missing-company filing discovery. Only SEC EDGAR hosts are
# allowlisted; the User-Agent should identify the deployment for SEC traffic.
# SEC requires a descriptive application name and contact address.
SEC_USER_AGENT=financial-rag-assistant/8.2 (contact: financial-rag-assistant@example.com)

# =========================
# LLM — Unified Provider
# =========================

LLM_PROVIDER=deepseek
# Explicit cost guard: set true only for a supervised live-provider run.
ALLOW_REAL_PROVIDER=false
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=45
LLM_TOTAL_DEADLINE=120
LLM_STREAM=false

# =========================
# Gemini
# =========================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# =========================
# OpenAI / Anthropic / Doubao
# =========================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-0-pro-260215
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Dedicated secret material used to encrypt user-provided LLM credentials.
# Use a long random value from your secret manager. To rotate, place the new
# value first and retain the previous value after a comma until all records
# have been rewritten. Never reuse AUTH_SECRET_KEY.
LLM_CREDENTIAL_ENCRYPTION_KEYS=
# Single-host deployments may instead set LLM_CREDENTIAL_KEY_FILE to a
# persistent, access-restricted path. Docker Compose uses the shared agent
# memory volume so API and worker load the same generated key.
LLM_CREDENTIAL_KEY_FILE=

# =========================
# HuggingFace
# =========================

HF_ENDPOINT=https://huggingface.co

# =========================
# Worker
# =========================

WORKER_CONCURRENCY=2
WORKER_POLL_TIMEOUT=1.0
MAX_TASK_RUNTIME=3600
WORKER_ID=agent-worker-1

# =========================
# Frontend (Vite)
# =========================

VITE_API_BASE_URL=/api
VITE_ENABLE_MOCK=false

# =========================
# Rate Limiting
# =========================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Evaluation-only plan-limit bypass for explicitly listed tenants. This covers
# chat and document quotas during local evaluation; keep disabled in production.
EVALUATION_BYPASS_PLAN_LIMITS=false
EVALUATION_BYPASS_TENANT_IDS=

# Product chat quota switch. Keep enabled by default; local evaluation may set false.
CHAT_PLAN_LIMITS_ENABLED=true

# =========================
# Security
# =========================

# Comma-separated browser origins.  Development defaults to localhost:5173
# when this variable is unset; set explicit public origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
